# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PayPal Developer Sandbox Credentials
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_SECRET=your-paypal-sandbox-client-secret
PAYPAL_ENVIRONMENT=SANDBOX

# PayPal Gate 1 smoke test only (scripts/paypal-sandbox-smoke.mjs). Non-secret Sandbox account emails.
# PAYPAL_PLATFORM_BUSINESS_EMAIL=   # Business sandbox account that owns the REST app (merchant/payout sender)
# PAYPAL_SMOKE_BUYER_EMAIL=         # Personal sandbox account used to approve the order
# PAYPAL_SMOKE_SELLER_EMAIL=        # third sandbox account that receives the payout

# Gate 1 v2 (scripts/paypal-sandbox-smoke-v2.mjs). Identifiers only, never secrets.
# PAYPAL_SMOKE_SELLER_MERCHANT_ID=  # delayed mode: seller's PayPal merchant/payer ID (onboarded to your platform)
# PAYPAL_SMOKE_BUYER_PAYER_ID=      # optional: buyer's payer ID, strengthens identity checks
# PAYPAL_PLATFORM_MERCHANT_ID=      # optional: platform merchant ID, used in fallback mode identity checks
# PAYPAL_PARTNER_MERCHANT_ID=       # optional: enables the read-only seller-status diagnostic
# PAYPAL_PARTNER_ATTRIBUTION_ID=    # optional: partner BN code, sent as PayPal-Partner-Attribution-Id if set

# Google Gemini AI API Key (via Vercel AI SDK)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key


# Dev-only switches (ignored in production)
# SEED_SECRET=long-random-string        # enables POST /api/seed with header x-seed-secret
# (DEMO_SIMULATE_PAYMENT was removed: payment is now only marked by verified PayPal capture.)

# ---- Transaction system (see docs/PAYMENTS.md). PayPal SANDBOX ONLY: any other PAYPAL_ENVIRONMENT disables payments.
# PAYPAL_ENVIRONMENT=SANDBOX
# PAYPAL_CLIENT_ID=                      # Sandbox REST app (server only)
# PAYPAL_SECRET=                         # Sandbox REST app secret (server only, never NEXT_PUBLIC_)
# PAYPAL_PLATFORM_BUSINESS_EMAIL=        # Sandbox business account that owns the app (payee check). Merchant ID below is stronger.
# PAYPAL_PLATFORM_MERCHANT_ID=           # optional but recommended: that account's merchant/payer ID
# PAYPAL_WEBHOOK_ID=                     # optional: enables POST /api/webhooks/paypal (needs a public HTTPS URL)
# APP_BASE_URL=http://localhost:3000     # origin PayPal returns buyers to (https in deployment)
# CRON_SECRET=long-random-string         # bearer secret for POST /api/internal/payouts/run
# RETURN_WINDOW_HOURS=24                 # return window after delivery confirmation (fractions allowed, e.g. 0.02 for testing)
# REVIEW_UNCONFIRMED_AFTER_DAYS=7        # shipped with no confirmation -> flagged for admin review (never auto-released)
# INVOICE_EXPIRY_HOURS=48
# MIN_DEAL_CENTS=100

# ---- AI negotiation (server-only; feature remains on manual flow unless explicitly enabled)
AI_NEGOTIATION_ENABLED=true
NEG_USER_DAILY_GEMINI_LIMIT=50
NEG_SESSION_GEMINI_LIMIT=12
NEG_TURN_LEASE_SECONDS=30

# Optional AG Studio trial licence (leave blank for local evaluation; never commit a real key).
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
