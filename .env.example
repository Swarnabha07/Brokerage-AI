# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PayPal Developer Sandbox Credentials
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_SECRET=your-paypal-sandbox-client-secret
PAYPAL_ENVIRONMENT=SANDBOX

# Google Gemini AI API Key (via Vercel AI SDK)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key


# Dev-only switches (ignored in production)
# SEED_SECRET=long-random-string        # enables POST /api/seed with header x-seed-secret
# DEMO_SIMULATE_PAYMENT=true            # lets a buyer simulate payment until PayPal Sandbox (Stage 3)
